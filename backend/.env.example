DOZOR_BASE_URL=https://a1.gpsguard.eu/api/v1
DOZOR_USER=your-dozor-username
DOZOR_PASS=your-dozor-password
DOZOR_TIMEOUT_MS=15000
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,https://*.vercel.app
PORT=4000
# Set to "true" to append a synthetic demo fleet (6 vehicles + trips) to the real
# GPS Dozor data. The real vehicle and all upstream calls are unchanged. Demo
# vehicles are clearly tagged "DEMO" in the UI. Leave unset/false for real-only.
DEMO_MODE=false
